---
/**
 * Disqus embed. `identifier` stabile (slug post) così i thread sopravvivono
 * al passaggio da /site/ al dominio custom.
 */
interface Props {
  identifier: string;
  url: string;
  title?: string;
}

const { identifier, url, title } = Astro.props;
const shortname = "bastachebastino";
---

<section class="comments" aria-labelledby="comments-heading">
  <h2 id="comments-heading">Commenti</h2>
  <div id="disqus_thread"></div>
  <noscript>
    <p class="muted">
      Abilita JavaScript per vedere i commenti (
      <a href="https://disqus.com/?ref_noscript">Disqus</a>).
    </p>
  </noscript>
</section>

<script is:inline define:vars={{ identifier, url, title, shortname }}>
  var disqus_config = function () {
    this.page.url = url;
    this.page.identifier = identifier;
    if (title) this.page.title = title;
  };
  (function () {
    var d = document,
      s = d.createElement("script");
    s.src = "https://" + shortname + ".disqus.com/embed.js";
    s.setAttribute("data-timestamp", String(+new Date()));
    (d.head || d.body).appendChild(s);
  })();
</script>
