---
import BaseLayout from "./BaseLayout.astro";
import DisqusThread from "../components/DisqusThread.astro";
import { withBase } from "../lib/base";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  order?: number;
  cover?: string;
  coverAlt?: string;
  /** Slug stabile per Disqus (es. id collezione). */
  identifier: string;
  /** Path canonico relativo al sito, es. articoli/slug/ */
  path: string;
}

const { title, description, pubDate, order, cover, coverAlt, identifier, path } = Astro.props;
const dateLabel = pubDate.toLocaleDateString("it-IT", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const canonicalUrl = new URL(path, Astro.site).href;
---

<BaseLayout title={title} description={description} path={path}>
  <article class="prose">
    {
      cover && (
        <figure class="cover">
          <img src={withBase(cover.replace(/^\//, ""))} alt={coverAlt || ""} width="1600" height="900" />
        </figure>
      )
    }
    <p class="meta">
      {order != null && <>Fondativi · {order} · </>}
      <time datetime={pubDate.toISOString()}>{dateLabel}</time>
    </p>
    <h1>{title}</h1>
    <slot />
  </article>
  <DisqusThread identifier={identifier} url={canonicalUrl} title={title} />
</BaseLayout>
