---
import BaseLayout from "./BaseLayout.astro";
import { withBase } from "../lib/base";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  order?: number;
  cover?: string;
  coverAlt?: string;
}

const { title, description, pubDate, order, cover, coverAlt } = Astro.props;
const dateLabel = pubDate.toLocaleDateString("it-IT", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={title} description={description}>
  <article class="prose">
    {
      cover && (
        <figure class="cover">
          <img src={withBase(cover.replace(/^\//, ""))} alt={coverAlt || ""} width="1600" height="900" />
        </figure>
      )
    }
    <p class="meta">
      {order != null && <>Fondativi · {order} · </>}
      <time datetime={pubDate.toISOString()}>{dateLabel}</time>
    </p>
    <h1>{title}</h1>
    <slot />
  </article>
</BaseLayout>
