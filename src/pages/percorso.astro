---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { withBase } from "../lib/base";

const posts = (await getCollection("posts", ({ data }) => data.draft !== true)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
);
---

<BaseLayout
  title="Percorso"
  description="I pezzi fondativi del percorso FIRE, nell’ordine in cui vanno letti."
>
  <section class="prose">
    <h1>Il percorso</h1>
    <p class="lede">
      Qui i pezzi stanno in fila, non a caso. Meglio leggerli così: prima il perché, poi come
      nascono queste pagine, poi l’obiettivo. Il resto arriverà lungo la strada.
    </p>
  </section>
  <ol class="list" style="list-style: none; counter-reset: none;">
    {
      posts.map((post) => (
        <li>
          <a class="list-cover" href={withBase(`articoli/${post.id}/`)}>
            {post.data.cover && (
              <img
                src={withBase(post.data.cover.replace(/^\//, ""))}
                alt={post.data.coverAlt || ""}
                width="320"
                height="180"
              />
            )}
            <span>
              <span style="display:block; font-size:1.15rem; color:inherit;">
                {post.data.order != null && `${String(post.data.order).padStart(2, "0")} · `}
                {post.data.title}
              </span>
              <span class="meta">{post.data.description}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</BaseLayout>
