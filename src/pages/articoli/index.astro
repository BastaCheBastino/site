---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../lib/base";

const posts = (await getCollection("posts", ({ data }) => data.draft !== true)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Articoli"
  description="Archivio degli articoli pubblicati, in ordine cronologico."
>
  <section class="prose">
    <h1>Articoli</h1>
    <p class="lede">
      L’archivio, dal più recente. Se è la prima volta che passi di qui, il posto giusto per
      cominciare è il percorso.
    </p>
  </section>
  <ul class="list">
    {
      posts.map((post) => (
        <li>
          <a class="list-cover" href={withBase(`articoli/${post.id}/`)}>
            {post.data.cover && (
              <img
                src={withBase(post.data.cover.replace(/^\//, ""))}
                alt={post.data.coverAlt || ""}
                width="320"
                height="180"
              />
            )}
            <span>
              <span style="display:block; font-size:1.15rem; color:inherit;">
                {post.data.title}
              </span>
              <span class="meta">
                {post.data.pubDate.toLocaleDateString("it-IT")} · {post.data.description}
              </span>
            </span>
          </a>
          <a
            class="comment-count"
            href={withBase(`articoli/${post.id}/`) + "#disqus_thread"}
            data-disqus-identifier={post.id}
          >
            commenti
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
