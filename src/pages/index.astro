---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { siteBase, withBase } from "../lib/base";

const latest = (await getCollection("posts", ({ data }) => data.draft !== true && !data.unlisted))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const base = siteBase();
---

<BaseLayout
  title="Home"
  path={base}
  description="Un percorso FIRE italiano in corso: numeri, decisioni e dubbi verso il 2034."
  showNewsletterBand
>
  <section class="hero">
    <h1>Un percorso FIRE italiano, mentre accade.</h1>
    <p class="lede">
      A quarantasei anni sto costruendo abbastanza libertà da poter scegliere, intorno al 2034,
      se continuare a lavorare. Qui ci sono i numeri e le decisioni di quel percorso — e i dubbi
      che li accompagnano — mentre succede, senza sapere come finisce.
    </p>
    <div class="cta-row">
      <a class="btn" href={withBase("percorso/")}>Inizia dal percorso</a>
      <a class="btn secondary" href={withBase("chi-sono/")}>Chi sono</a>
    </div>
  </section>

  <h2>Ultimi articoli</h2>
  <ul class="list">
    {
      latest.map((post) => (
        <li>
          <a class="list-cover" href={withBase(`articoli/${post.id}/`)}>
            {post.data.cover && (
              <img
                src={withBase(post.data.cover.replace(/^\//, ""))}
                alt={post.data.coverAlt || ""}
                width="320"
                height="180"
              />
            )}
            <span>
              <span style="display:block; font-size:1.15rem; color:inherit;">
                {post.data.title}
              </span>
              <span class="meta">
                {post.data.pubDate.toLocaleDateString("it-IT")} · {post.data.description}
              </span>
            </span>
          </a>
          <a
            class="comment-count"
            href={withBase(`articoli/${post.id}/`) + "#disqus_thread"}
            data-disqus-identifier={post.id}
          >
            commenti
          </a>
        </li>
      ))
    }
  </ul>
  <div class="cta-row">
    <a class="btn secondary" href={withBase("articoli/")}>Tutti gli articoli</a>
  </div>
</BaseLayout>
